{
  "name": "speckit-eye",
  "version": "1.0.0",
  "description": "Zero-setup progress dashboard for GitHub Spec Kit projects",
  "keywords": [
    "spec-kit",
    "speckit",
    "github-spec-kit",
    "spec-driven-development",
    "dashboard",
    "progress",
    "tasks",
    "cli",
    "static-site"
  ],
  "homepage": "https://serafac.github.io/speckit-eye/",
  "bugs": {
    "url": "https://github.com/SerafAC/speckit-eye/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SerafAC/speckit-eye.git"
  },
  "author": "SerafAC",
  "type": "module",
  "bin": {
    "speckit-eye": "bin/speckit-eye.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "src/",
    "!src/styles/",
    "dist/styles.css",
    "dist/fonts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:assets": "tailwindcss -i src/styles/input.css -o dist/styles.css --minify && node scripts/copy-assets.js",
    "docs:build": "node scripts/build-site.js",
    "prepack": "pnpm run build:assets",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "test:e2e": "pnpm run build:assets && playwright test",
    "prepublishOnly": "node -e \"if(!process.env.GITHUB_ACTIONS){console.error('Publish only from the Release workflow: see docs/releasing.md');process.exit(1)}\""
  },
  "dependencies": {
    "markdown-it": "^15"
  },
  "devDependencies": {
    "@docmd/core": "0.9.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63",
    "@tailwindcss/cli": "^4.1",
    "@tailwindcss/typography": "^0.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1"
  },
  "license": "MIT"
}
