{
  "name": "speckit-eye",
  "version": "1.0.0",
  "description": "Zero-setup progress dashboard for GitHub Spec Kit projects",
  "type": "module",
  "bin": {
    "speckit-eye": "bin/speckit-eye.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "src/",
    "!src/styles/",
    "dist/styles.css",
    "dist/fonts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:assets": "tailwindcss -i src/styles/input.css -o dist/styles.css --minify && node scripts/copy-assets.js",
    "prepack": "pnpm run build:assets",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "test:e2e": "pnpm run build:assets && playwright test"
  },
  "dependencies": {
    "markdown-it": "^15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63",
    "@tailwindcss/cli": "^4.1",
    "@tailwindcss/typography": "^0.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1"
  },
  "license": "MIT"
}
